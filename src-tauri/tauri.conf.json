{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deskpad",
  "version": "0.1.0",
  "identifier": "com.jgentes.deskpad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Deskpad",
        "url": "index.html",
        "width": 340,
        "height": 900,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "capture",
        "title": "Capture task",
        "url": "capture.html",
        "width": 560,
        "height": 96,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
